# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it contains passwords.

# Flask secret key — generate one at: https://djecrety.ir/
SECRET_KEY=replace-with-a-long-random-string

# Database — leave blank to use SQLite locally.
# On Railway this is set automatically when you add a PostgreSQL plugin.
DATABASE_URL=

# Per-user accounts: a default admin account (username: admin, password:
# changeme123) is created automatically on first run — check the console
# output. Log in as admin, go to /admin, and invite everyone else.

# Email (Gmail recommended) — only used for the "resend invite" button.
# The primary invite flow (copy link, send manually) works without this.
# 1. Create or use a Gmail account for sending notifications
# 2. Enable 2-Factor Authentication on that Gmail account
# 3. Go to: Google Account > Security > App Passwords
# 4. Create an App Password for "Mail" and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password

# The public URL of your app (used in invite/email links)
# Example: https://iama-reconciliation.up.railway.app
APP_URL=http://localhost:5050
