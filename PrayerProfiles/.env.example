# Prayer Profiles — Environment Variables
# Copy this file to .env and fill in real values before running in production.
# NEVER commit your .env file to git.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Invite code required to create new accounts.
# Share this only with people you want to be able to register.
INVITE_CODE=your-secret-invite-code

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the server listens on (default: 3001)
# PORT=3001

# Directory for storing profiles.json and uploads/ (default: project root)
# DATA_DIR=/data

# Set to "1" automatically by the Electron desktop build — do not set manually
# in a hosted deployment. Skips rate limiting and the invite-code requirement.
# ELECTRON_APP=1

# Public base URL of this deployment, used to build links in emails (e.g. password reset).
# APP_ORIGIN=https://prayer-profiles.fly.dev

# Resend (https://resend.com) API key for sending password-reset emails.
# Without this set, reset links are logged to the server console instead of emailed.
# RESEND_API_KEY=

# "From" address for outgoing emails — must be a verified sender/domain in Resend.
# RESET_EMAIL_FROM=Prayer Profiles <onboarding@resend.dev>

# Shared secret required in the x-admin-key header to read /api/admin/metrics.
# Leave unset to disable the metrics endpoint entirely.
# ADMIN_KEY=

# VAPID keypair for web-push reminder notifications. Generate with:
#   npx web-push generate-vapid-keys
# Leave unset to disable push notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
