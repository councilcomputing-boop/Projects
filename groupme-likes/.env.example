# Get your token at https://dev.groupme.com (log in, then "Access Token" in the top right)
GROUPME_TOKEN=your_token_here
# The numeric group ID (see README for how to find it)
GROUPME_GROUP_ID=12345678
# Optional
# PORT=5000
# DB_PATH=groupme.db
# Optional: member user IDs (comma-separated) to leave out of "Hasn't liked"
# NOT_LIKED_EXCLUDE=
